# ==============================================================================
# TrafficFlow AI - Environment Variables Example
# Duplicate as .env and adapt for your environment
# ==============================================================================

# Database Settings
DB_HOST=localhost
DB_PORT=3306
DB_NAME=trafficflow
DB_USERNAME=root
DB_PASSWORD=root
DB_URL=jdbc:mysql://localhost:3306/trafficflow?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true

# Security Settings
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Service URLs
AI_SERVICE_URL=http://localhost:8000
VITE_API_URL=http://localhost:8080/api
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Port Settings
PORT=8080
AI_PORT=8000
FRONTEND_PORT=5173
